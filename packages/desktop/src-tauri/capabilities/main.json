{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "allow-server-connect",
    "allow-server-write",
    "allow-server-ack",
    "allow-server-disconnect",
    "allow-connection-command",
    "allow-cancel-connection-command"
  ]
}
