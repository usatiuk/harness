{
  "name": "@harness/harness-cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "harness": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx --conditions=development src/bin.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/chmod-package-bins.mjs ."
  },
  "dependencies": {
    "@harness/auth-openai": "0.0.0",
    "@harness/core": "0.0.0",
    "@harness/model-openai": "0.0.0",
    "@harness/model-openai-chatgpt": "0.0.0",
    "@harness/plugin-control": "0.0.0",
    "@harness/plugin-mcp": "0.0.0",
    "@harness/plugin-subagents": "0.0.0",
    "@harness/plugin-tasks": "0.0.0",
    "@harness/protocol": "0.0.0",
    "@harness/sandbox-host": "0.0.0",
    "@harness/service": "0.0.0",
    "@harness/store-sqlite": "0.0.0",
    "@harness/tools-basic": "0.0.0",
    "@harness/ui-protocol": "0.0.0",
    "commander": "^15.0.0",
    "ink": "^7.0.5",
    "react": "^19.2.7"
  }
}
