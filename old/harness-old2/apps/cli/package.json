{
    "name": "@harness/cli",
    "version": "0.0.0",
    "type": "module",
    "bin": {
        "harness": "./dist/bin.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./src/index.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "dev": "tsx --conditions=development src/bin.ts",
        "build": "tsc -p tsconfig.build.json && node ../../scripts/chmod-package-bins.mjs"
    },
    "dependencies": {
        "@harness/auth-openai": "0.0.0",
        "@harness/core": "0.0.0",
        "@harness/model-openai": "0.0.0",
        "@harness/model-openai-chatgpt": "0.0.0",
        "@harness/protocol": "0.0.0",
        "@harness/service": "0.0.0",
        "@harness/store-sqlite": "0.0.0",
        "commander": "^15.0.0"
    },
    "files": [
        "dist",
        "src"
    ]
}
