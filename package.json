{
  "name": "harness",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/development.mjs cli",
    "release:payloads": "node scripts/development.mjs node release/tools/build-payloads.mjs",
    "release:version": "node scripts/development.mjs node --conditions=development --import=tsx release/tools/version.ts",
    "release:artifacts": "node scripts/development.mjs node --conditions=development --import=tsx release/tools/artifacts.ts",
    "release:desktop": "node scripts/development.mjs node --conditions=development --import=tsx release/tools/build-desktop.mjs",
    "release:source": "node scripts/development.mjs node --conditions=development --import=tsx release/tools/source.ts",
    "release:finalize": "node scripts/development.mjs node --conditions=development --import=tsx release/tools/finalize.ts",
    "runtime:prepare": "cargo run --quiet --manifest-path native/Cargo.toml --bin harness -- --prepare-node",
    "runtime:setup": "node scripts/development.mjs npm ci",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/desktop/tsconfig.json",
    "desktop:dev": "node scripts/development.mjs npm run desktop:dev --workspace @harness/desktop",
    "desktop:build": "node scripts/development.mjs npm run desktop:build --workspace @harness/desktop",
    "prepare:remote": "node scripts/development.mjs node release/tools/prepare-remote.mjs",
    "test:remote": "node scripts/development.mjs node --conditions=development --import=tsx packages/connections/tools/test-remote.mjs",
    "test:wsl": "node scripts/development.mjs node --conditions=development --import=tsx packages/connections/tools/test-wsl.mjs",
    "test:native": "node scripts/development.mjs npm run test:native --workspace @harness/desktop",
    "test": "node scripts/development.mjs node node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/development.mjs node node_modules/vitest/vitest.mjs",
    "test:coverage": "node scripts/development.mjs node node_modules/vitest/vitest.mjs run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol:schema": "tsx --conditions=development scripts/generate-protocol-schema.ts",
    "check": "node scripts/development.mjs npm run check:managed",
    "check:managed": "npm run typecheck && npm run lint && npm run format:check && vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
