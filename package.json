{
  "name": "harness",
  "version": "0.1.17",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx --conditions=development packages/cli/src/bin.ts",
    "release:payloads": "node scripts/build-payloads.mjs --release",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/desktop/tsconfig.json",
    "desktop:dev": "npm run desktop:dev --workspace @harness/desktop",
    "desktop:build": "npm run desktop:build --workspace @harness/desktop",
    "prepare:remote": "node scripts/build-payloads.mjs --remote",
    "test:remote": "node --conditions=development --import=tsx packages/connections/tools/test-remote.mjs",
    "test:wsl": "node --conditions=development --import=tsx packages/connections/tools/test-wsl.mjs",
    "test:native": "npm run test:native --workspace @harness/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "protocol:schema": "tsx --conditions=development scripts/generate-protocol-schema.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && vitest run",
    "prepare": "husky && npm run native:build",
    "native:build": "node scripts/build-native.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.9.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
